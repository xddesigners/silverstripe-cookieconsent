{
    "name": "xddesigners/silverstripe-cookieconsent",
    "description": "Cookie bar and consent checker for Silverstripe",
    "type": "silverstripe-vendormodule",
    "keywords": ["silverstripe", "GDPR", "Cookie", "Bar", "Consent"],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Remy Vaartjes",
            "email": "remy@xd.nl"
        }
    ],
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6",
        "silverstripe/cms": "^6",
        "silverstripe/admin": "^3",
        "silverstripe/siteconfig": "^6",
        "symbiote/silverstripe-gridfieldextensions": "^5"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3",
        "silverstripe/sqlite3": "*",
        "squizlabs/php_codesniffer": "^3.9",
        "phpstan/phpstan": "^2",
        "phpstan/extension-installer": "^1.4",
        "cambis/silverstan": "^2"
    },
    "suggest": {
        "tractorcow/silverstripe-fluent": "Translatable banner copy and cookie declaration",
        "symbiote/silverstripe-queuedjobs": "Scheduled pruning of the immutable consent log"
    },
    "scripts": {
        "lint": "phpcs",
        "lint-fix": "phpcbf",
        "phpstan": "phpstan analyse",
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true,
            "silverstripe/recipe-plugin": true,
            "phpstan/extension-installer": true,
            "php-http/discovery": false
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "expose": [
            "client/dist/js",
            "client/dist/styles"
        ],
        "branch-alias": {
            "dev-main": "6.x-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "XD\\CookieConsent\\": "src"
        }
    }
}
